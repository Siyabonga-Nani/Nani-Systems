# ==============================================================================
# NANI SYSTEMS V1 — ENVIRONMENT CONFIGURATION
# ==============================================================================
# 
# IMPORTANT: Never commit actual secrets or credentials to version control.
# Copy this file to .env and fill in the required values for your environment.

# ------------------------------------------------------------------------------
# CORE DATABASE (REQUIRED)
# ------------------------------------------------------------------------------
# The PostgreSQL connection string for Prisma.
DATABASE_URL="postgresql://user:password@host:port/database"

# ------------------------------------------------------------------------------
# ADMIN AUTHENTICATION (REQUIRED)
# ------------------------------------------------------------------------------
# Strong password required to access the /admin routes.
ADMIN_PASSWORD="your-secure-admin-password"

# A secure 32-character crypto secret used by JOSE to sign JWT session tokens.
# You can generate one using: openssl rand -base64 32
ADMIN_SECRET="your-32-character-crypto-secret-for-jose-jwt"

# ------------------------------------------------------------------------------
# APPLICATION URL (REQUIRED)
# ------------------------------------------------------------------------------
# The public-facing URL of the application (e.g., https://www.nanisystems.com).
# Used for generating absolute links in emails and client portals.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# PAYPAL INTEGRATION (REQUIRED FOR PAYMENTS)
# ------------------------------------------------------------------------------
# 'sandbox' for testing, 'production' for live payments
PAYPAL_ENVIRONMENT="sandbox"
PAYPAL_CLIENT_ID="your_paypal_client_id"
PAYPAL_SECRET="your_paypal_secret"

# ------------------------------------------------------------------------------
# NOTIFICATIONS (OPTIONAL / FUTURE)
# ------------------------------------------------------------------------------
# Email routing configuration for internal lead notifications and system alerts.
ADMIN_EMAIL="admin@nanisystems.com"
EMAIL_PROVIDER_NAME=""
EMAIL_PROVIDER_API_KEY=""
